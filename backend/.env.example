# Postgres (async URL used by the app, sync URL used by Alembic)
# Port 5434, not 5432 - see docker-compose.yml (this machine already runs a
# native Postgres on 5432).
DATABASE_URL=postgresql+asyncpg://gametaste:gametaste@localhost:5434/gametaste
DATABASE_URL_SYNC=postgresql+psycopg2://gametaste:gametaste@localhost:5434/gametaste

REDIS_URL=redis://localhost:6379/0

# IGDB (via Twitch OAuth) - https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Anthropic - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Steam Web API - phase 6, not needed yet
STEAM_API_KEY=
